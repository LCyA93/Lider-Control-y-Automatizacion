<?xml version="1.0" encoding="UTF-8"?>
<odoo>


    <!-- ========================form view================= -->
    <record id="sh_api_scope_view_form" model="ir.ui.view">
        <field name="name">sh.api.scope.view.form</field>
        <field name="model">sh.api.scope</field>
        <field name="arch" type="xml">
            <form string="scope">
                <sheet>
                    <group>
                        <field name="name"></field>
                        <field name="code"></field>
                        <field name="is_active"></field>
                        <field name="api_type"></field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ==========================List============== -->
    <record id="sh_api_scope_view_list" model="ir.ui.view">
        <field name="name">sh.api.scope.view.list</field>
        <field name="model">sh.api.scope</field>
        <field name="arch" type="xml">
            <list string="scope">
                <field name="name"></field>
                <field name="api_type"></field>
            </list>
        </field>
    </record>


