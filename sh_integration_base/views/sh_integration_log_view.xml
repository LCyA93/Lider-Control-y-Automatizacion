<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- =========================FORM VIEW ===================== -->
    <record id="sh_base_integration_form_view" model="ir.ui.view">
        <field name="name">sh.integration.log.form</field>
        <field name="model">sh.integration.log</field>
        <field name="arch" type="xml">
            <form string="Integration Log">
                <header>
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="description"></field>
                            <field name="create_date"></field>
                            <field name="log_type" />
                            <field name="company_id"/>
                            <field name="response" widget="text"/>
                            <field name="config_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!-- ================== LIST VIEW ========================== -->
    <record id="sh_base_integration_list_view" model="ir.ui.view">
        <field name="name">sh.integration.log.list</field>
        <field name="model">sh.integration.log</field>
        <field name="arch" type="xml">
            <list multi_edit="1" decoration-success="state=='success'" decoration-danger="state=='error'">
                <field name="name" />
                <field name="description" widget="text"></field>
                <field name="create_date"></field>
                <field name="log_type" widget="badge" ></field>
                <field name="company_id" optional="hide"/>
                <field name="config_id"/>
                <field name="response" widget="text" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>
    <!-- ========================== SEARCH VIEW ======================= -->
    <record id="sh_integration_log_search_view" model="ir.ui.view">
        <field name="name">sh.integration.log.search.view</field>
        <field name="model">sh.integration.log</field>
        <field name="arch" type="xml">
            <search string="Log">
                <field name="name"/>
                <field name="state"/>
                <field name="log_type" />
                <separator />
                <filter string="Success" name="success" domain="[('state', '=', 'success')]" />
                <filter string="Error" name="error" domain="[('state', '=', 'error')]" />
                <filter string="Authorization" name="auth" domain="[('log_type', '=', 'auth')]" />
                <group>
                    <filter name="status_filter" string="Status" context="{'group_by':'state'}" />
                    <filter name="log_type_filter" string="Log Type" context="{'group_by':'log_type'}" />
                </group>
            </search>
        </field>
    </record>







    <!-- ====================== ACTION =================== -->
    <record id="sh_integration_view_action" model="ir.actions.act_window">
        <field name="name">Integration Logs</field>
        <field name="res_model">sh.integration.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'edit': 0,'create': 0}</field>
    </record>
</odoo>