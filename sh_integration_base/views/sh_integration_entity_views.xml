<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List view -->
    <record id="sh_integration_entity_list_view" model="ir.ui.view">
        <field name="name">sh.integration.entity.list</field>
        <field name="model">sh.integration.entity</field>
        <field name="arch" type="xml">
            <list string="Integration Entities" default_group_by="connector_id">
                <field name="sequence" widget="handle"/>
                <field name="connector_id"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="domain"/>
                <field name="icon"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="sh_integration_entity_form_view" model="ir.ui.view">
        <field name="name">sh.integration.entity.form</field>
        <field name="model">sh.integration.entity</field>
        <field name="arch" type="xml">
            <form string="Integration Entity">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="connector_id"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group string="Model &amp; Filter">
                            <field name="model_id"/>
                            <field name="model_name" readonly="1"/>
                            <field name="domain" widget="domain" options="{'model': 'model_name'}"/>
                            <field name="icon" placeholder="fa-database"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="sh_integration_entity_action" model="ir.actions.act_window">
        <field name="name">Integration Entities</field>
        <field name="res_model">sh.integration.entity</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'group_by': ['connector_id']}</field>
    </record>

    <!-- Menu item under Overview -->
    <menuitem
        id="sh_integration_entity_menu"
        name="Entity Configuration"
        parent="sh_base_config_root"
        action="sh_integration_entity_action"
        sequence="5"/>

</odoo>
