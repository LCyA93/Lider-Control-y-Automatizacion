<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sh_base_config_form_view" model="ir.ui.view">
        <field name="name">sh.integration.config.form</field>
        <field name="model">sh.integration.config</field>
        <field name="arch" type="xml">
            <form string="Integration Configuration">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,authorized"/>
                    <button name="authorize_btn"  string="Authorize" type="object" class="oe_highlight" invisible="1"/>
                </header>
                <sheet>
                    <field name="icon_image" widget="image"  class="oe_avatar" ></field>
                    <group>
                        <group>
                            <field name="name" readonly ="1"/>
                            <field name="sh_type"
                            readonly="1"
                            />
                            <field name="company_id" readonly ="state == 'authorized'"/>
                            <field name="client_id" readonly ="state == 'authorized'" invisible="1" ></field>
                            <field name="client_secret" password="1" readonly ="state == 'authorized'" invisible="1"></field>
                        </group>
                        <group>
                            <field name="redirect_url" widget="CopyClipboardChar" invisible="1"></field>
                            <field name="scope_ids" widget="many2many_tags" invisible="1"></field>
                        </group>
                    </group>
                    <!-- Log History Section -->
                    <notebook>
                    </notebook>
                    <br/>
                    <h6>Log History</h6>
                    <hr/>
                    <field name="log_ids" readonly="1">
                        <list editable="bottom"  decoration-success="state=='success'" decoration-danger="state=='error'">
                            <field name="name"/>
                            <field name="description"/>
                            <field name="create_date"></field>
                            <field name="log_type" widget="badge"></field>
                            <field name="company_id"/>
                            <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'error'"/>
                            <button name="action_open_log_record" type="object" string="View Response" icon="fa-eye"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="sh_base_config_list_view" model="ir.ui.view">
        <field name="name">sh.integration.config.list</field>
        <field name="model">sh.integration.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="sh_type" />
                <field name="company_id"/>
            </list>
        </field>
    </record>
    <!-- ==========kanban view =========== -->
    <record id="sh_base_config_view_kanban" model="ir.ui.view">
        <field name="name">sh.integration.config.view.kanban</field>
        <field name="model">sh.integration.config</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="icon_image" widget="image" options="{'size' : [60,60]}"/>
                        </aside>
                        <group >
                            <field name="name" class="fw-bolder" string="Name"/>
                        </group>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="sh_base_config_form_view_action" model="ir.actions.act_window">
        <field name="name">Integration Hub</field>
        <field name="res_model">sh.integration.config</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'create': 0}</field>
    </record>
</odoo>